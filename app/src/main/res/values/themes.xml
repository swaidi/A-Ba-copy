<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_bg">#486CB8</color>
    <color name="brand_accent">#0B4662</color>

    <style name="Theme.ScreenTextCopy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_bg</item>
        <item name="colorSecondary">@color/brand_accent</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="SliderLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="Theme.ScreenTextCopy.Capture"parent="Theme.ScreenTextCopy">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
